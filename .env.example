# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://alightconsultants.in

# PostgreSQL connection string. URL-encode special characters in the password (@ -> %40).
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5433/alight?schema=public"

# SMTP for enquiry notifications (never exposed to the browser)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Alight Consultants <no-reply@alightconsultants.in>"
ENQUIRY_NOTIFY_TO=info@alightconsultants.in
# Optional separate inboxes (blank = ENQUIRY_NOTIFY_TO). Admin > Settings values take priority.
QUOTE_NOTIFY_TO=
CAREERS_NOTIFY_TO=
SEND_CUSTOMER_ACK=true

# One-time admin setup: /admin/setup requires this token (16+ random chars) and only works
# while no admin users exist. Remove it after creating the first Super Admin.
ADMIN_SETUP_TOKEN=

# Uploaded images (persistent disk, outside the deploy folder). Example: D:/AlightData/uploads
UPLOAD_DIR=./data/uploads
