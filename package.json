{
  "name": "alight-consultants-website",
  "version": "1.0.0",
  "private": true,
  "description": "Alight Consultants Pvt. Ltd. — corporate website, enquiry platform and CMS",
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:import-sqlite": "node prisma/import-sqlite.cjs",
    "db:export-sql": "node prisma/export-sql.cjs",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "nodemailer": "^6.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
