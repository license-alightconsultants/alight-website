# Production settings for the Alight website.
# Copy to D:\Alight\config\alight.env (outside the app folder) and restrict access:
#   icacls D:\Alight\config /inheritance:r /grant:r "Administrators:(OI)(CI)F" "SYSTEM:(OI)(CI)F"
# Values here are read by build-release.ps1, start-server.ps1 and backup.ps1.

# Public URL. Baked into the build (canonical URLs, sitemap, Open Graph) - rebuild after changing.
NEXT_PUBLIC_SITE_URL=https://alightconsultants.in

# PostgreSQL connection. Create a dedicated role and database first (see docs/DEPLOYMENT.md).
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://alight:CHANGE_ME@localhost:5432/alight?schema=public

# Folder holding pg_dump.exe / pg_restore.exe (optional; auto-detected under C:\Program Files\PostgreSQL).
PG_BIN=

# Uploaded images - absolute path on persistent disk.
UPLOAD_DIR=D:/Alight/data/uploads

# Node listens on 127.0.0.1 at this port; IIS forwards to it (must match web.config).
PORT=3000

# SMTP (can also be set in Admin > Settings; admin values take priority).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Alight Consultants <no-reply@alightconsultants.in>
ENQUIRY_NOTIFY_TO=info@alightconsultants.in
# Optional separate inboxes (blank = ENQUIRY_NOTIFY_TO). Admin > Settings values take priority.
QUOTE_NOTIFY_TO=
CAREERS_NOTIFY_TO=
SEND_CUSTOMER_ACK=true

# One-time admin setup token (16+ random characters). Only works while no admin exists.
# Leave empty once the first Super Admin has been created.
ADMIN_SETUP_TOKEN=

# Backups older than this many days are deleted by backup.ps1.
BACKUP_RETENTION_DAYS=30
