<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site for alightconsultants.in -> Node.js on 127.0.0.1:3000.
  Requires: URL Rewrite 2.1 + Application Request Routing 3.0, and setup-iis.ps1 run once
  (enables the proxy, preserves the Host header, allows the server variables below).
  Point the IIS site's physical path at D:\Alight\app (this file is copied there on each deploy).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Force HTTPS (skipped for local health checks over http://localhost). -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
            <add input="{HTTP_HOST}" pattern="^localhost(:\d+)?$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Optional: redirect www to the bare domain. Remove if www is the canonical host. -->
        <rule name="Canonical host" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTP_HOST}" pattern="^www\.(.+)$" /></conditions>
          <action type="Redirect" url="https://{C:1}/{R:1}" redirectType="Permanent" />
        </rule>

        <rule name="Proxy to Node" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- Overwrite anything the client sent: the app trusts only the last entry. -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Hide IIS server header">
          <match serverVariable="RESPONSE_Server" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Admin image uploads: 30 MB total per request (each image is limited to 5 MB by the app). -->
        <requestLimits maxAllowedContentLength="31457280" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".next" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- Next.js sends its own error pages; let them through instead of IIS defaults. -->
    <httpErrors existingResponse="PassThrough" />
    <!-- Node compresses responses already. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
  </system.webServer>
</configuration>
